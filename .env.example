# Copy this file to .env.local and fill in the values. Never commit .env.local.
# On Vercel, add the same names under Settings > Environment Variables.

# AI marking of theory answers and the AI study tutor (server-side only, never reaches the browser)
LLM_API_KEY=
# Optional. Defaults to Groq's OpenAI-compatible endpoint and model if left empty.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# Optional: low | medium | high
LLM_REASONING_EFFORT=

# Supabase (not connected yet; the app runs on this device's storage until it is)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Email verification codes at sign-up (server-side only).
# Works with a normal Gmail account, no domain needed:
#   SMTP_USER = the Gmail address that sends the codes
#   SMTP_PASS = a Google "app password" for that account (not the normal Gmail password)
SMTP_USER=
SMTP_PASS=
# Optional. Defaults to Gmail (smtp.gmail.com, port 465) and "GhanaPrep <SMTP_USER>".
SMTP_HOST=
SMTP_PORT=
MAIL_FROM=
# Optional. Secret used to sign verification codes. Defaults to SMTP_PASS if left empty.
AUTH_SECRET=

# "Continue with Google" on the sign-in screen. The button stays hidden until this is set.
# It is the OAuth "Web application" client ID from Google Cloud (see README). It is safe to be public.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
