# Copy this file to .env.local and fill in the values. Never commit .env.local.
# On Vercel, add the same names under Settings > Environment Variables.

# AI marking of theory answers and the AI study tutor (server-side only, never reaches the browser)
LLM_API_KEY=
# Optional. Defaults to Groq's OpenAI-compatible endpoint and model if left empty.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# Optional: low | medium | high
LLM_REASONING_EFFORT=

# Supabase (not connected yet; the app runs on this device's storage until it is)
SUPABASE_URL=
SUPABASE_ANON_KEY=
